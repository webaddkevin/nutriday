// Prisma Schema 文件
// 文档：https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id            Int            @id @default(autoincrement())
  openid        String         @unique  // 微信 openid
  unionid       String?        @unique  // 微信 unionid（可选）
  sessionKey    String?                 // 微信会话密钥（用于解密敏感数据）
  email         String?
  name          String?
  nickname      String?
  avatarUrl     String?
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       UserProfile?
  mealLogs      MealLog[]
  shoppingItems ShoppingItem[]
  mealPlans     MealPlan[]
  weightLogs    WeightLog[]
  waterLogs     WaterLog[]
  foodFavorites FoodFavorite[]
}

// 用户画像（onboarding 信息）
model UserProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  gender        String
  age           Int
  height        Float
  weight        Float
  goal          String
  tags          String   @default("[]")
  activityLevel Float
  bmr           Float?
  tdee          Float?
  // 目标设置
  targetWeight  Float?
  targetDate    String?
  weeklyGoal    Float?   // 每周目标变化 (kg)
  targetCalories Float?  // 目标每日热量
  // 健康档案
  allergies     String   @default("[]")  // 过敏原 JSON 数组
  diseases      String   @default("[]")  // 慢性疾病 JSON 数组
  medications   String   @default("[]")  // 用药情况 JSON 数组
  dietaryRestrictions String @default("[]") // 饮食限制 JSON 数组
  healthNotes   String?  // 其他健康备注
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

// 食物数据库
model Food {
  id          Int       @id @default(autoincrement())
  name        String
  nameEn      String?
  category    String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  sodium      Float?
  servingSize Float     @default(100)
  unit        String    @default("g")
  imageUrl    String?
  barcode     String?   @unique  // 条形码
  brand       String?   // 品牌
  source      String    @default("custom")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mealLogs    MealLog[]
  favorites   FoodFavorite[]

  @@index([name])
  @@index([category])
  @@index([barcode])
}

// 饮食记录
model MealLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  mealType  String
  foodId    Int
  foodName  String
  amount    Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  food      Food     @relation(fields: [foodId], references: [id])

  @@index([userId, date])
  @@index([userId, date, mealType])
}

// 购物清单
model ShoppingItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  foodId    Int?
  name      String
  category  String
  amount    String
  unit      String   @default("g")
  calories  Int      @default(0)
  protein   Float    @default(0)
  carbs     Float    @default(0)
  fat       Float    @default(0)
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, checked])
}

// 备餐计划
model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  mealType  String
  foodId    Int?
  foodName  String?
  dishName  String
  amount    Int?
  calories  Int
  protein   Float?
  carbs     Float?
  fat       Float?
  logged    Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
  @@index([userId, date, mealType])
}

// 体重记录
model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  weight    Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date]) // 每天只能记录一次
  @@index([userId, date])
}

// 饮水记录
model WaterLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  amount    Float    // 饮水量 (ml)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date]) // 每天只能记录一次
  @@index([userId, date])
}

// 食物收藏
model FoodFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  foodId    Int
  note      String?  // 用户备注
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  food      Food     @relation(fields: [foodId], references: [id])

  @@unique([userId, foodId]) // 每个食物只能收藏一次
  @@index([userId])
}
