// Prisma Schema 文件
// 文档：https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String?
  nickname      String?
  avatarUrl     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       UserProfile?
  mealLogs      MealLog[]
  shoppingItems ShoppingItem[]
  mealPlans     MealPlan[]
  weightLogs    WeightLog[]
}

// 用户画像（onboarding 信息）
model UserProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  gender        String
  age           Int
  height        Float
  weight        Float
  goal          String
  tags          String   @default("[]")
  activityLevel Float
  bmr           Float?
  tdee          Float?
  // 目标设置
  targetWeight  Float?
  targetDate    String?
  weeklyGoal    Float?   // 每周目标变化 (kg)
  targetCalories Float?  // 目标每日热量
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

// 食物数据库
model Food {
  id          Int       @id @default(autoincrement())
  name        String
  nameEn      String?
  category    String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  sodium      Float?
  servingSize Float     @default(100)
  unit        String    @default("g")
  imageUrl    String?
  source      String    @default("custom")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mealLogs    MealLog[]

  @@index([name])
  @@index([category])
}

// 饮食记录
model MealLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  mealType  String
  foodId    Int
  foodName  String
  amount    Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  food      Food     @relation(fields: [foodId], references: [id])

  @@index([userId, date])
  @@index([userId, date, mealType])
}

// 购物清单
model ShoppingItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  category  String
  amount    String
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, checked])
}

// 备餐计划
model MealPlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  mealType  String
  dishName  String
  calories  Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

// 体重记录
model WeightLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      String
  weight    Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date]) // 每天只能记录一次
  @@index([userId, date])
}
